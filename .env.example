# ── Constructa landing + dashboard: Supabase ─────────────────────────────────
# Publishable keys (sb_publishable_…) are PUBLIC-safe (client + committable).
# The service-role key is SECRET — set it only in Vercel project env, never here.

# Client (Vite, build-time inlined)
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxx

# Server / SSR (process.env at runtime on Vercel)
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxx

# SECRET — bypasses RLS. Set in Vercel env only. DO NOT commit a real value.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxxx

# Optional: origin of the 3D editor projects open in.
# Defaults to https://constructa.atumx.in if unset.
VITE_EDITOR_ORIGIN=https://constructa.atumx.in
